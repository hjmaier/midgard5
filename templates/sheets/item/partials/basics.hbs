<div class="midgard5-item-basics-container">
    <div class="midgard5-item-basics-item1">{{localize "midgard5.item.quantity"}}<input name="system.quantity" type="number" step="any"
            value="{{system.quantity}}" data-dtype="Number" /></div>
    <div class="midgard5-item-basics-item1">{{localize "midgard5.item.value"}}<input name="system.value" type="number" step="any"
            value="{{system.value}}"  /></div>
    <div class="midgard5-item-basics-item1">{{localize "midgard5.item.active"}}<input name="system.active" type="checkbox"
            {{checked system.active}} /></div>
    <div class="midgard5-item-basics-item1">{{localize "midgard5.item.ismagic"}}<input name="system.magic" type="checkbox"
            {{checked system.magic}} /></div>
    <div class="midgard5-item-basics-item1">{{localize "midgard5.item.abw"}}<input name="system.abw" type="number" step="any"
            value="{{system.abw}}"  /></div>
    <div class="midgard5-item-basics-item1">{{localize "midgard5.item.weight"}}<input name="system.weight" type="number" step="any"
            value="{{system.weight}}"  /></div>
    <div class="midgard5-item-basics-item1">{{localize "midgard5.item.container"}}<input name="system.container"
            type="text" value="{{system.container}}"  /></div>

</div>